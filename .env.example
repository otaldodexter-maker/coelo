# Coelo local environment template.
# Copy this file to .env for local commands. Never commit .env.
#
# Flutter client values are public once bundled into web/mobile builds.
# Keep this section limited to client-safe configuration.

COELO_APP_ENV=local
COELO_SUPABASE_URL=
COELO_SUPABASE_PUBLISHABLE_KEY=
COELO_DEV_MFA=false

# Example Flutter usage:
# flutter run --dart-define=COELO_SUPABASE_URL=http://127.0.0.1:54321 --dart-define=COELO_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
#
# Never pass server-only secrets to Flutter:
# - SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY
# - R2_SECRET_ACCESS_KEY
# - payment, email, AI, webhook, admin, or provider secret tokens
