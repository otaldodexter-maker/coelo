+  bool hasAccessModelDuplicateCapability(String? domain) {
+    final actor = session.authContext;
+    return session.isAuthenticated &&
+        !session.isPasswordRecovery &&
+        session.sessionId?.isNotEmpty == true &&
+        AccessProfileDomain.values.any((item) => item.databaseValue == domain) &&
+        actor != null &&
+        actor.platformRoleCode == 'owner' &&
+        actor.scopeKind == SuperadminAuthScopeKind.platform &&
+        actor.permissionCodes.contains('$domain.role_models.read') &&
+        actor.permissionCodes.contains('$domain.role_models.create') &&
+        actor.permissionCodes.contains('platform.role_models.read');
+  }
